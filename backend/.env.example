# SyncLab - Environment Configuration Example
# Copie este arquivo para .env e preencha os valores

# ===========================================
# Servidor HTTP
# ===========================================
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# ===========================================
# Banco de Dados PostgreSQL
# ===========================================
# Formato: postgresql://usuario:senha@host:porta/database
# Exemplo local: postgresql://postgres:postgres@localhost:5432/synclab
# Exemplo Docker: postgresql://postgres:postgres@db:5432/synclab
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/synclab

# Pool de conexões (opcional)
# DB_POOL_MAX=10
# DB_IDLE_TIMEOUT_MS=30000
# DB_CONNECTION_TIMEOUT_MS=5000
# Sessão HTTP (Parte 86)
SESSION_COOKIE_NAME=synclab_session
SESSION_TTL_SECONDS=2592000
# Google OAuth 2.0 (opcional; necessário para login Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
APP_BASE_URL=http://localhost:5173