{
  "name": "synclab-backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "migrate": "tsx --env-file=.env src/infrastructure/persistence/migrations/run.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/server.js",
    "dev": "node --env-file=.env --import=tsx/esm src/server.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^11.2.0",
    "argon2": "^0.45.1",
    "fastify": "^5.12.0",
    "pg": "^8.23.0",
    "sql.js": "^1.8.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@types/sql.js": "^1.4.9",
    "tsx": "^4.23.12",
    "typescript": "~5.7.0",
    "vitest": "^3.0.0"
  }
}
